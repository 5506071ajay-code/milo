# ---- required in production ----
NODE_ENV=production
PORT=8787
MILO_PUBLIC_URL=https://milo.example.com          # exact origin users open; also the OAuth redirect base
MILO_SESSION_SECRET=change-me-long-random          # signs session cookies
MILO_ENCRYPTION_KEY=change-me-long-random          # AES-256-GCM key for provider tokens at rest
MILO_DB_PATH=./data/milo.sqlite

# ---- Google sign-in (the only application login) ----
# Google Cloud Console → OAuth client (Web) → Authorised redirect URI: ${MILO_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- local development only (never in production) ----
# MILO_AUTH_DEV_MODE=true

# ---- financial providers (each adapter turns itself on when its variables exist) ----
SETU_AA_CLIENT_ID=            # RBI Account Aggregator via Setu (banks, cards, loans, MF)
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
SETU_AA_BASE_URL=https://fiu-uat.setu.co   # sandbox; production: https://fiu.setu.co
KITE_API_KEY=                 # Zerodha Kite Connect (approved app required)
KITE_API_SECRET=
UPSTOX_API_KEY=               # Upstox developer app
UPSTOX_API_SECRET=
# MILO_DISABLE_DEMO=true      # hide the demo sandbox provider
